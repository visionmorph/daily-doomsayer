{
  "name": "daily-doomsayer-news-feed",
  "private": true,
  "type": "module",
  "scripts": {
    "update-news": "node scripts/fetch-news.mjs",
    "update-dread-body-aware": "node scripts/update-dread-body-aware.mjs",
    "build-calibration-benchmark": "node scripts/build-calibration-benchmark.mjs",
    "build-calibration-review-queue": "node scripts/build-calibration-review-queue.mjs",
    "analyze-calibration-review": "node scripts/analyze-calibration-review.mjs",
    "build-calibration-benchmark:v2": "node scripts/build-calibration-benchmark-v2.mjs",
    "analyze-calibration": "node scripts/analyze-human-calibration.mjs",
    "evaluate-candidate": "node scripts/evaluate-dread-candidate.mjs",
    "evaluate-candidate:1.2.4": "node scripts/evaluate-dread-candidate.mjs --module scripts/doom-index-v1.2.4.mjs --function calculateDoomIndexV124 --version 1.2.4 --formula-version 1.2.4-offline.1 --cohort data/human-calibration/cohorts/dread-1.2.4-development.json --minimum-holdout 25 --minimum-high-confidence 10 --minimum-sources 5",
    "evaluate-experimental:1.2.4": "node scripts/evaluate-dread-experimental.mjs --baseline data/human-calibration/cohorts/dread-1.2.4-live-baseline.json --public-version 1.2.2 --public-formula-version 1.2.2-shadow.1 --experimental-version 1.2.4 --experimental-formula-version 1.2.4-offline.1 --human-rubric-version guided-human-rating-v1.1 --minimum-live 50 --minimum-high-confidence 30 --minimum-sources 10 --bootstrap-samples 10000",
    "evaluate-body-aware:1.3": "node scripts/evaluate-dread-v1.3.mjs",
    "verify-news": "node --test tests/body-aware-evaluation.test.mjs tests/calibration-guidance.test.mjs tests/calibration-review.test.mjs tests/doom-index-v1.2.test.mjs tests/doom-index-v1.2.1.test.mjs tests/doom-index-v1.2.2.test.mjs tests/doom-index-v1.2.3.test.mjs tests/doom-index-v1.2.4.test.mjs tests/doom-index-v1.3.0.test.mjs tests/human-calibration.test.mjs tests/live-experimental-evaluation.test.mjs tests/site-data.test.mjs && node scripts/verify-doom-index.mjs"
  },
  "dependencies": {
    "entities": "^2.2.0",
    "rss-parser": "^3.13.0"
  }
}
